{
  "name": "@praxis/types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types for the Praxis API (hand-written domain types + generated OpenAPI schema).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts"
  },
  "scripts": {
    "gen:types": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/api/v1/openapi.json} -o src/openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'types: covered by typecheck'"
  },
  "devDependencies": {
    "@praxis/config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
