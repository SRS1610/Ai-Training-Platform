    },
    {
      "id": "close_incident",
      "tool": "console",
      "label": "Close incident SEC-2291",
      "kind": "submit",
      "listed": true,
      "score": {},
      "effects": [],
      "classification": "correct",
      "time_cost": 0.5,
      "feedback": "",
      "outputs": [],
      "messages": [],
      "description": "",
      "branches": [
        {
          "id": "uncontained",
          "when": {
            "!": {
              "and": [
                {
