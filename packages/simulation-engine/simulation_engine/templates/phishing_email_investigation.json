      ]
    },
    {
      "id": "reset_everyone",
      "tool": "console",
      "label": "Force password reset for all 1,200 staff",
      "kind": "command",
      "listed": true,
      "score": {
        "containment": -5,
        "communication": -3
      },
      "effects": [
