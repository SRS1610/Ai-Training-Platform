                    [
                      "phishing",
                      "phish",
                      "scam"
                    ],
                    [
                      "password",
                      "credentials"
                    ],
                    [
                      "report",
                      "reported"
                    ],
                    [
                      "click",
                      "link"
                    ],
                    [
                      "delete",
                      "removed",
                      "quarantined"
                    ]
