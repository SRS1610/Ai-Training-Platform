          "classification": "correct",
          "effects": [
            {
              "set": {
                "classification": "phishing",
                "incident_status": "Investigating"
              }
            }
          ],
          "score": {
            "technical_analysis": 5,
            "containment": 2
          }
        },
        {
          "id": "legitimate",
          "when": {
            "==": [
              {
                "var": "$input.choice"
              },
              "legitimate"
            ]
          },
          "classification": "critical",
          "effects": [
            {
              "set": {
                "classification": "legitimate",
                "incident_status": "Closed - false positive"
              }
            },
            {
              "complete": "failure"
            }
          ],
          "score": {
            "technical_analysis": -10
          },
          "feedback": "Marking a credential-phishing email as legitimate leaves 47 users exposed."
        },
        {
          "id": "other",
          "when": true,
          "classification": "incorrect",
          "effects": [
            {
              "set": {
                "classification": "{{$input.choice}}"
              }
            }
          ],
          "score": {
            "technical_analysis": -3
          },
          "feedback": "Look again at the sender domain, failed SPF/DMARC and the sandbox verdict."
        }
      ],
      "input": {
        "type": "choice",
        "choices": [
          {
            "id": "phishing",
            "label": "Credential phishing"
          },
          {
            "id": "spam",
            "label": "Spam / marketing"
          },
          {
            "id": "legitimate",
            "label": "Legitimate Microsoft notice"
          },
          {
            "id": "malware",
            "label": "Malware attachment"
          }
        ]
      }
    },
    {
      "id": "quarantine_all",
      "tool": "console",
      "label": "Purge & quarantine the message from all mailboxes",
      "kind": "command",
      "listed": true,
      "score": {
        "containment": 5
      },
      "effects": [
        {
          "set": {
            "quarantined": true
          }
        }
