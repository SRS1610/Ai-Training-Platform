      "kind": "select",
      "listed": true,
      "score": {},
      "effects": [],
      "classification": "correct",
      "time_cost": 0.5,
      "feedback": "",
      "outputs": [],
      "messages": [],
      "description": "",
      "branches": [
        {
          "id": "phishing",
          "when": {
            "==": [
