{
  "schema_version": "1.0",
  "key": "phishing-email-investigation",
  "meta": {
    "title": "Phishing Email Investigation",
    "description": "SOC Level 1: triage a user-reported 'Microsoft 365 security alert' email, analyse headers and the link, scope the campaign in the SIEM, contain it and recover a compromised account.",
    "industry": "cybersecurity",
    "environment_type": "soc",
    "difficulty": "intermediate",
    "estimated_minutes": 20,
    "learner_role": "SOC Analyst (Level 1)",
    "briefing": "Three staff reported a suspicious 'Unusual sign-in activity' email to the phishing mailbox. Investigate it with the email headers, URL sandbox and SIEM, decide whether it is malicious, contain the campaign and handle any compromised accounts. Your team lead Tom expects a brief update.",
    "objectives": [
      "Analyse headers and the embedded URL",
      "Scope impact in the SIEM",
      "Contain: quarantine and block",
      "Recover compromised accounts",
      "Communicate and close"
    ],
    "tags": [
      "security",
      "phishing",
      "incident-response",
      "soc"
    ]
  },
  "environment": {
    "panels": [
      {
        "id": "inbox",
        "type": "email_inbox",
        "title": "Phishing report mailbox",
        "data": {
          "messages": [
            {
              "id": "msg-1",
              "from": "Microsoft 365 Security <security@micros0ft-support.com>",
              "subject": "Unusual sign-in activity - verify your account",
              "received": "Today 09:31",
              "reported_by": [
                "a.patel",
                "m.rossi",
                "l.chen"
              ],
              "body": "We detected an unusual sign-in to your account. To avoid suspension, verify your identity within 24 hours: [Verify account](hxxps://login-microsoftonline.secure-verify[.]top/o365/)"
            }
          ]
        }
      },
      {
        "id": "headers",
        "type": "email_viewer",
        "title": "Message headers",
        "visible_when": {
          "action_taken": "view_headers"
        },
        "data": {
          "headers": {
            "From": "security@micros0ft-support.com",
            "Return-Path": "bounce@mail-relay-sg.xyz",
            "Received": "from mail-relay-sg.xyz (185.234.72.19)",
            "Authentication-Results": "spf=fail; dkim=none; dmarc=fail action=none",
            "X-Originating-IP": "185.234.72.19"
          }
        }
      },
      {
        "id": "sandbox",
        "type": "url_sandbox",
        "title": "URL sandbox",
        "visible_when": {
          "action_taken": "sandbox_url"
        },
        "data": {
          "url": "hxxps://login-microsoftonline.secure-verify[.]top/o365/",
          "verdict": "Malicious",
          "category": "Credential harvesting",
          "domain_age_days": 2,
          "notes": "Clone of the Microsoft 365 sign-in page; credentials POSTed to /gate.php"
        }
      },
      {
        "id": "siem",
        "type": "siem_alerts",
        "title": "SIEM",
        "visible_when": {
          "action_taken": "query_siem"
        },
        "data": {
          "alerts": [
            {
              "time": "09:31",
              "source": "Email gateway",
              "severity": "medium",
              "text": "Message 'Unusual sign-in activity' delivered to 47 recipients"
            },
            {
              "time": "09:40-09:52",
              "source": "Web proxy",
              "severity": "high",
              "text": "3 users visited secure-verify[.]top: j.nguyen, a.patel, m.rossi"
            },
            {
              "time": "09:47",
              "source": "Entra ID",
              "severity": "high",
              "text": "j.nguyen: successful sign-in from 185.234.72.19 (LT), MFA satisfied by push approval"
            }
          ]
        }
      },
      {
        "id": "console",
        "type": "dashboard",
        "title": "Response console",
        "data": {
          "incident": "SEC-2291",
          "status": "{{incident_status}}"
        }
      }
    ]
  },
  "tools": [
    {
      "id": "inbox",
      "name": "Phishing mailbox",
      "panel": "inbox",
      "icon": "mail"
    },
    {
      "id": "sandbox",
      "name": "URL sandbox",
      "panel": "sandbox",
      "icon": "shield"
    },
    {
      "id": "siem",
      "name": "SIEM",
      "panel": "siem",
      "icon": "activity"
    },
    {
      "id": "console",
      "name": "Response console",
      "panel": "console",
      "icon": "settings"
    },
    {
      "id": "chat",
      "name": "Chat",
      "icon": "message"
    }
  ],
  "characters": [
    {
      "id": "jasmine",
      "name": "Jasmine Nguyen",
      "role": "Accounts Payable Officer",
      "avatar": "JN",
      "persona": "Worried employee who clicked the link and wants to know if she's in trouble.",
      "fallback_reply": "Sorry, what do you mean?",
      "facts": [
        {
          "id": "f_entered",
          "text": "Jasmine entered her password on the page."
        },
        {
          "id": "f_mfa",
          "text": "Jasmine approved an unexpected MFA push notification."
        },
        {
          "id": "f_time",
          "text": "She clicked the link at about 09:45."
        }
      ]
    },
    {
      "id": "tom",
      "name": "Tom Becker",
      "role": "SOC Team Lead",
      "avatar": "TB",
      "persona": "Calm, direct team lead who wants concise status updates.",
      "fallback_reply": "Keep it brief: what's the status?",
      "patience_var": "lead_patience",
      "patience_decay_per_minute": 1.0,
      "facts": []
    }
  ],
  "intents": [
    {
      "id": "entered_credentials",
      "patterns": [
        "password",
        "credentials",
        "log in",
        "login",
        "sign in",
        "enter details",
        "type in"
      ]
    },
    {
      "id": "mfa_prompt",
      "patterns": [
        "mfa",
        "approve",
        "push",
        "notification",
        "authenticator",
        "code"
      ]
    },
    {
      "id": "when_clicked",
      "patterns": [
        "when click",
        "what time",
        "when open"
      ]
    },
    {
      "id": "status_update",
      "patterns": [
        "update",
        "status",
        "brief",
        "summary",
        "findings",
        "contained"
      ],
      "examples": [
        "Quick update: it's a credential phishing campaign, now contained."
      ]
    },
    {
      "id": "reassure",
      "patterns": [
        "not trouble",
        "not in trouble",
        "dont worry",
        "did right",
        "thanks report"
      ]
    }
  ],
  "phases": [
    {
      "id": "INITIAL",
      "name": "Triage",
      "transitions": [
        "ANALYSIS"
      ],
      "auto_advance": [
        {
          "to": "ANALYSIS",
          "when": {
            ">=": [
              {
                "var": "$actions_count"
              },
              1
            ]
          }
        }
      ]
    },
    {
      "id": "ANALYSIS",
      "name": "Analysis",
      "transitions": [
        "CONTAINMENT"
      ],
      "auto_advance": [
        {
          "to": "CONTAINMENT",
          "when": {
            "==": [
              {
                "var": "classification"
              },
              "phishing"
            ]
          }
        }
      ]
    },
    {
      "id": "CONTAINMENT",
      "name": "Containment",
      "transitions": [
        "RECOVERY"
      ],
      "auto_advance": [
        {
          "to": "RECOVERY",
          "when": {
            "and": [
              {
                "var": "quarantined"
              },
              {
                "var": "sender_blocked"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "RECOVERY",
      "name": "Recovery",
      "transitions": [
        "REPORTING"
      ],
      "auto_advance": [
        {
          "to": "REPORTING",
          "when": {
            "var": "creds_reset"
          }
        }
      ]
    },
    {
      "id": "REPORTING",
      "name": "Reporting",
      "terminal": true
    }
  ],
  "variables": {
    "campaign_ground_truth": {
      "type": "str",
      "initial": "credential_harvest_jnguyen_compromised",
      "visibility": "secret"
    },
    "incident_status": {
      "type": "str",
      "initial": "New",
      "visibility": "public",
      "label": "Incident status"
    },
    "lead_patience": {
      "type": "float",
      "initial": 100,
      "min": 0,
      "max": 100
    },
    "classification": {
      "type": "str",
      "initial": ""
    },
    "headers_checked": {
      "type": "bool",
      "initial": false
    },
    "url_analysed": {
      "type": "bool",
      "initial": false
    },
    "siem_checked": {
      "type": "bool",
      "initial": false
    },
    "scoped": {
      "type": "bool",
      "initial": false
    },
    "user_interviewed": {
      "type": "bool",
      "initial": false
    },
    "quarantined": {
      "type": "bool",
      "initial": false
    },
    "sender_blocked": {
      "type": "bool",
      "initial": false
    },
    "creds_reset": {
      "type": "bool",
      "initial": false
    },
    "mass_reset": {
      "type": "bool",
      "initial": false
    },
    "users_notified": {
      "type": "bool",
      "initial": false
    },
    "lead_briefed": {
      "type": "bool",
      "initial": false
    },
    "ir_notified": {
      "type": "bool",
      "initial": false
    },
    "forwarding_rule": {
      "type": "bool",
      "initial": false
    }
  },
  "opening_messages": [
    {
      "text": "3 new reports in the phishing mailbox. Incident SEC-2291 opened."
    },
    {
      "character": "tom",
      "text": "Can you take SEC-2291? Let me know what we're dealing with."
    }
  ],
  "actions": [
    {
      "id": "open_report",
      "tool": "inbox",
      "label": "Open the reported email",
      "kind": "inspect",
      "listed": true,
      "score": {
        "investigation": 2
      },
      "effects": [],
      "classification": "correct",
      "time_cost": 0.5,
      "feedback": "",
      "outputs": [
        {
          "text": "Reported email opened: sender *micros0ft-support.com* (zero, not 'o'), urgent tone, link to an external domain.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "view_headers",
      "tool": "inbox",
      "label": "View full message headers",
      "kind": "inspect",
      "listed": true,
      "score": {
        "technical_analysis": 4,
        "investigation": 2
      },
      "effects": [
        {
          "set": {
            "headers_checked": true
          }
        }
      ],
      "classification": "correct",
      "time_cost": 1,
      "feedback": "Headers show spoofed branding from an unauthenticated sender.",
      "outputs": [
        {
          "text": "SPF **fail**, DKIM none, DMARC **fail**; Return-Path *mail-relay-sg.xyz*; originating IP 185.234.72.19.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "sandbox_url",
      "tool": "sandbox",
      "label": "Detonate the link in the URL sandbox",
      "kind": "inspect",
      "listed": true,
      "score": {
        "technical_analysis": 5,
        "investigation": 2
      },
      "effects": [
        {
          "set": {
            "url_analysed": true
          }
        }
      ],
      "classification": "correct",
      "time_cost": 2,
      "feedback": "",
      "outputs": [
        {
          "text": "Verdict **Malicious**: credential-harvesting clone of the Microsoft 365 sign-in page. Domain registered 2 days ago.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "click_link_live",
      "tool": "inbox",
      "label": "Open the link in your own browser",
      "kind": "command",
      "listed": true,
