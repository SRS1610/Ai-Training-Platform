        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "delete_reported_only",
      "tool": "console",
      "label": "Delete the email from the reporters' inboxes only",
      "kind": "command",
      "listed": true,
      "score": {
        "containment": -3
      },
      "effects": [],
      "classification": "incorrect",
      "time_cost": 1.0,
      "feedback": "Only removing reported copies leaves the lure in 44 other inboxes.",
      "outputs": [
        {
          "text": "3 copies deleted. 44 remain in other mailboxes.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "block_sender",
      "tool": "console",
      "label": "Block sender domain and phishing URL (gateway + proxy)",
      "kind": "command",
      "listed": true,
      "score": {
        "containment": 5,
        "technical_analysis": 2
      },
      "effects": [
        {
          "set": {
            "sender_blocked": true
          }
        }
      ],
      "classification": "correct",
      "time_cost": 1,
      "feedback": "",
      "outputs": [
        {
          "text": "Blocked micros0ft-support.com at the mail gateway and secure-verify.top at the web proxy.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": ""
    },
    {
      "id": "reset_jnguyen",
      "tool": "console",
      "label": "Reset j.nguyen's password and revoke sessions/MFA tokens",
      "kind": "command",
      "listed": true,
      "score": {},
      "effects": [],
      "classification": "correct",
      "time_cost": 2,
      "feedback": "",
      "outputs": [
        {
          "text": "j.nguyen: password reset, refresh tokens revoked, MFA re-registration required.",
          "format": "markdown"
        }
      ],
      "messages": [],
      "description": "Contain the compromised account.",
      "branches": [
        {
          "id": "evidence",
          "when": {
            "or": [
              {
                "var": "siem_checked"
              },
              {
                "var": "user_interviewed"
              }
            ]
          },
          "classification": "correct",
          "effects": [
            {
              "set": {
                "creds_reset": true,
                "incident_status": "Contained"
              }
            }
          ],
          "score": {
            "containment": 6,
            "technical_analysis": 2
          }
        },
        {
          "id": "no_evidence",
          "when": true,
          "classification": "correct",
          "effects": [
            {
              "set": {
                "creds_reset": true,
                "incident_status": "Contained"
              }
            }
          ],
          "score": {
            "containment": 4,
            "investigation": -2
          },
          "feedback": "Right action, but confirm compromise in the SIEM or with the user first."
