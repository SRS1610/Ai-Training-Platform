      "listed": true,
      "score": {
        "investigation": 4,
        "technical_analysis": 3
      },
      "effects": [
        {
          "set": {
            "siem_checked": true
          }
        }
      ],
      "classification": "correct",
      "time_cost": 2,
      "feedback": "",
      "outputs": [
        {
          "text": "47 recipients; 3 users visited the phishing domain; **j.nguyen** has a successful sign-in from 185.234.72.19 with MFA approved.",
