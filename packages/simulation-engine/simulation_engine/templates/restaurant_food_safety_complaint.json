{
  "schema_version": "1.0",
  "key": "restaurant-food-safety-complaint",
  "meta": {
    "title": "Restaurant Customer Complaint: Food Safety",
    "description": "Hospitality duty manager: a guest who declared a peanut allergy reports a reaction. Put guest safety first, recover the service, investigate and complete the incident report.",
    "industry": "hospitality",
    "environment_type": "front_of_house",
    "difficulty": "beginner",
    "estimated_minutes": 15,
    "learner_role": "Duty Manager",
    "briefing": "It's Saturday dinner service at Harbour Kitchen. Mia, a server, calls you to table 12: Daniel Okafor says his green curry had nuts in it even though he told her about his peanut allergy. He's upset. Handle it.",
    "objectives": [
      "Check the guest's wellbeing first",
      "De-escalate and apologise sincerely",
      "Investigate how the allergen got onto the plate",
      "Remove the hazard",
      "Record and report the incident"
    ],
    "tags": [
      "hospitality",
      "food-safety",
      "allergens",
      "service-recovery"
    ]
  },
  "environment": {
    "panels": [
      {
        "id": "complaint",
        "type": "crm_record",
        "title": "Table 12",
        "data": {
          "guest": "Daniel Okafor",
          "covers": 2,
          "order": "Thai green curry, jasmine rice",
          "server": "Mia",
          "allergy_declared": "Peanuts (per server)",
          "status": "{{case_status}}"
