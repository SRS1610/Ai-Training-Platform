  "phases": [
    {
      "id": "INITIAL",
      "name": "Arrive at table",
      "transitions": [
        "ASSESS"
      ],
      "auto_advance": [
        {
          "to": "ASSESS",
          "when": {
            ">=": [
              {
                "var": "$actions_count"
              },
              1
            ]
          }
        }
      ]
    },
    {
      "id": "ASSESS",
      "name": "Assess guest safety",
      "transitions": [
        "INVESTIGATE"
      ],
      "auto_advance": [
        {
          "to": "INVESTIGATE",
          "when": {
            "or": [
              {
                "var": "symptoms_checked"
              },
              {
                "var": "medical_called"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "INVESTIGATE",
      "name": "Investigate",
      "transitions": [
        "RESOLVE"
      ],
      "auto_advance": [
        {
          "to": "RESOLVE",
          "when": {
            "and": [
              {
                "var": "cause_found"
              },
              {
                "var": "hazard_removed"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "RESOLVE",
      "name": "Resolve",
      "transitions": [
        "FOLLOW_UP"
      ],
      "auto_advance": [
        {
          "to": "FOLLOW_UP",
          "when": {
            "var": "incident_reported"
          }
        }
      ]
    },
    {
      "id": "FOLLOW_UP",
      "name": "Follow up",
      "terminal": true
    }
  ],
