# Copy to .env (never commit real secrets). Values shown are safe development defaults.

# --- Core ---------------------------------------------------------------------------------
APP_NAME=Praxis Training Platform
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://praxis:praxis@localhost:5432/praxis
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
# Defaults to REDIS_URL when empty. ALWAYS_EAGER runs Celery tasks inline (no worker needed; dev/tests only).
# CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Security -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-dev-only-secret-change-me-dev-only
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
MFA_CHALLENGE_TTL_MINUTES=5
EMAIL_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30

# --- OAuth / SSO --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- AI -----------------------------------------------------------------------------------
# offline = deterministic built-in demo provider (no key needed). openai | anthropic | azure_openai | google | local
AI_DEFAULT_PROVIDER=offline
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Gemini (GEMINI_API_KEY is accepted as a fallback)
GOOGLE_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio); the key is optional
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=

# --- Storage (local | s3) -----------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.storage
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET=
# S3-compatible endpoint (MinIO, R2); leave empty for AWS
# AWS_S3_ENDPOINT_URL=http://localhost:9000
MAX_UPLOAD_MB=50
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Billing (Stripe) ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Stripe price ids per plan/interval (seat-based plans use per-seat prices)
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Usage-based AI pricing (Stripe metered price + meter event name); overage billed at cost x markup
STRIPE_PRICE_AI_METERED=
STRIPE_AI_METER_EVENT_NAME=ai_usage_cents
AI_OVERAGE_MARKUP=1.25
BILLING_CURRENCY=aud

# --- Email (console | smtp | ses) ---------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=Praxis <no-reply@praxis.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Web Push (generate with: npx web-push generate-vapid-keys) --------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@praxis.local
WEB_PUSH_TTL_SECONDS=86400

# --- Observability ------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=false
