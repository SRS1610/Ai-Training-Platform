# Copy to .env (never commit real secrets). Values shown are safe development defaults.

# --- Core ---------------------------------------------------------------------------------
ENVIRONMENT=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://praxis:praxis@localhost:5432/praxis
REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-dev-only-secret-change-me-dev-only
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

# --- OAuth / SSO --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- AI -----------------------------------------------------------------------------------
# offline = deterministic built-in demo provider (no key needed). openai | anthropic | azure_openai | local
AI_DEFAULT_PROVIDER=offline
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
LOCAL_MODEL_BASE_URL=

# --- Storage (local | s3) -----------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.storage
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET=
CLAMAV_HOST=

# --- Billing (Stripe) ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Stripe price ids per plan/interval (seat-based plans use per-seat prices)
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Usage-based AI pricing (Stripe metered price + meter event name); overage billed at cost x markup
STRIPE_PRICE_AI_METERED=
STRIPE_AI_METER_EVENT_NAME=ai_usage_cents
AI_OVERAGE_MARKUP=1.25
BILLING_CURRENCY=aud

# --- Email (console | smtp | ses) ---------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=Praxis <no-reply@praxis.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Web Push (generate with: npx web-push generate-vapid-keys) --------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@praxis.local
WEB_PUSH_TTL_SECONDS=86400

# --- Observability ------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_JSON=false
